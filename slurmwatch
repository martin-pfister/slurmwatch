#!/usr/bin/env python3
"""slurmwatch - wait for a Slurm job's output file, then follow it from the top.

Usage:
    slurmwatch 1234567                # job id: ask Slurm where its output goes
    slurmwatch slurm-1234567.out      # explicit path, relative or absolute
    slurmwatch ~/runs/run-42.log      # explicit path
    slurmwatch 'slurm-*.out'          # explicit glob

Unlike `tail -f`, this waits for the file to appear, prints it from the very
first byte, and exits by itself once the job reaches a terminal state.

For a job id the real name comes from `scontrol show job`. The id must be
known to Slurm (queue or accounting log); if it is not, and no
./slurm-<id>.out exists either, slurmwatch explains that and exits rather
than waiting for a job that will never write anything.

Job output goes to stdout, status messages to stderr, so
`slurmwatch 123 > log` gives you a clean log file.

Works with Python 3.6 and newer (no third-party modules).
"""

import argparse
import glob
import os
import re
import shutil
import signal
import subprocess
import sys
import time

# States in which the job is still alive, so the output file can still grow.
ACTIVE_STATES = frozenset([
    "PENDING",
    "RUNNING",
    "CONFIGURING",
    "COMPLETING",
    "REQUEUED",
    "REQUEUE_FED",
    "REQUEUE_HOLD",
    "RESIZING",
    "SUSPENDED",
    "STOPPED",
    "SIGNALING",
    "STAGE_OUT",
    "RESV_DEL_HOLD",
    "SPECIAL_EXIT",
])

CHUNK = 1 << 16
POLL = 1.0        # file poll interval; the floor of the backoff
MAX_POLL = 10.0   # ceiling the interval backs off to while nothing is written
BACKOFF = 1.5     # growth factor per idle tick
JOB_POLL = 3.0    # first Slurm query interval once the file is quiet
JOB_POLL_MAX = 60.0  # longest gap between Slurm queries
HEARTBEAT = 120.0    # seconds between "still waiting" messages
DRAIN = 10.0      # stop reading once output has been quiet this long
CMD_TIMEOUT = 10.0

# What a single Slurm query tells us.
ACTIVE = "active"    # alive, output can still grow
DONE = "done"        # reached a final state, we know which
GONE = "gone"        # no record anywhere: cancelled, removed, or pruned
UNKNOWN = "unknown"  # Slurm could not be asked at all


def log(msg):
    print("slurmwatch: %s" % msg, file=sys.stderr, flush=True)


class Unavailable(Exception):
    """A Slurm command is missing or failed."""


class JobNotFound(Unavailable):
    """squeue answered, but the job is no longer in its records."""


def _run(cmd):
    if shutil.which(cmd[0]) is None:
        raise Unavailable("%s not found" % cmd[0])
    try:
        # universal_newlines, not text= : the latter is Python 3.7+.
        env = os.environ.copy()
        env["LC_ALL"] = "C"  # keep Slurm's error messages recognizable
        proc = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
            timeout=CMD_TIMEOUT,
            universal_newlines=True,
        )
    except (subprocess.SubprocessError, OSError) as exc:
        raise Unavailable(str(exc))
    if proc.returncode != 0:
        if cmd[0] == "squeue" and "Invalid job id specified" in proc.stderr:
            raise JobNotFound("job is no longer known to squeue")
        raise Unavailable("%s exited %d" % (cmd[0], proc.returncode))
    return proc.stdout


# --------------------------------------------------------------------------
# asking Slurm


def is_job_id(target):
    """A Slurm job id: '1234567' or an array task '1234567_3'."""
    job, sep, task = target.partition("_")
    return bool(job) and job.isdigit() and (not sep or task.isdigit())


def job_state(job_id):
    """Slurm's word on the job.

    A state string while it is known, "" once it is gone, None if Slurm cannot
    be asked at all (tools missing, transient error) - so a broken query is
    never mistaken for a finished job.
    """
    try:
        # -h drops the header; an empty answer means "not in the queue".
        out = _run(["squeue", "-h", "-j", job_id, "-o", "%T"]).strip()
        if out:
            return out.splitlines()[0].strip()
    except JobNotFound:
        pass  # a pruned job can still have a final state in accounting
    except Unavailable:
        return None

    # Not queued: it either finished, or never existed. sacct knows the former.
    try:
        out = _run(["sacct", "-n", "-P", "-X", "-j", job_id, "-o", "State"])
    except Unavailable:
        return ""  # squeue answering "not queued" is evidence enough
    for line in out.splitlines():
        if line.strip():
            return line.split("|")[0].strip()
    return ""


def scontrol_fields(job_id):
    """`scontrol show job` as a dict, or None if Slurm cannot answer.

    Values can contain spaces (`StdOut=/scratch/my dir/out.log`), so split only
    where a new `Key=` starts rather than on every space.
    """
    try:
        out = _run(["scontrol", "-o", "show", "job", job_id])
    except Unavailable:
        return None

    fields = {}
    for chunk in re.split(r"\s+(?=\w+=)", out.strip()):
        key, sep, value = chunk.partition("=")
        if sep:
            fields[key] = value.strip('"')
    return fields or None


def state_from(fields):
    """The job's state out of scontrol's fields. Same job, one call."""
    return fields.get("JobState", "").strip()


def is_active(state):
    words = state.upper().split()
    return bool(words) and words[0].rstrip("+") in ACTIVE_STATES


def expand_escapes(pattern, fields):
    """Expand the %-escapes Slurm allows in --output.

    None if the pattern needs something we cannot know before the job runs:
    node name (%N), step (%s), or an array index when no task was named
    (%a/%t on a job id without _<task>). Better to fall back than to wait for
    a file that will never be created.
    """
    job_id = fields.get("JobId", "")
    array_job, _, array_task = job_id.partition("_")
    table = {
        "%": "%",
        # %j is the full id including the array task, e.g. 500_7.
        "j": job_id,
        "x": fields.get("JobName", ""),
        "u": fields.get("UserId", "").split("(")[0],
    }
    if array_task:
        # %a/%t are the task index; %A is the array's own id.
        table["a"] = table["t"] = array_task
        table["A"] = fields.get("ArrayJobId") or array_job
    try:
        return re.sub(r"%(.)", lambda m: table[m.group(1)], pattern)
    except KeyError:
        return None


def output_path(fields):
    """Where this job writes stdout, from its scontrol fields."""
    pattern = fields.get("StdOut")
    if not pattern or pattern == "NONE":
        return None

    path = expand_escapes(pattern, fields)
    if path is None or path == "/dev/null":
        return path

    if not os.path.isabs(path):
        workdir = fields.get("WorkDir", "")
        base = workdir if workdir and os.path.isdir(workdir) else os.getcwd()
        path = os.path.join(base, path)
    return os.path.normpath(path)


# --------------------------------------------------------------------------
# locating and reading the file


def locate(candidates):
    """First existing regular file among the candidates."""
    for path in candidates:
        if any(ch in path for ch in "*?["):
            matches = sorted(m for m in glob.glob(path) if os.path.isfile(m))
            if matches:
                return matches[0]
        elif os.path.isfile(path):
            return path
    return None


def pump(path, pos):
    """Copy everything after `pos` in `path` to stdout; return the new offset."""
    try:
        if os.path.getsize(path) < pos:
            log("file shrank (recreated), reading it again from the top")
            pos = 0
        with open(path, "rb") as fh:
            fh.seek(pos)
            while True:
                chunk = fh.read(CHUNK)
                if not chunk:
                    break
                sys.stdout.buffer.write(chunk)
                pos += len(chunk)
        sys.stdout.buffer.flush()
    except OSError:
        pass  # not there (yet) or unreadable; the next tick retries
    return pos


# --------------------------------------------------------------------------


def resolve(target):
    """Turn the argument into candidate paths, or fail.

    Returns (candidates, exit_code). A job id must be known to Slurm; a path
    must at least be plausible (existing directory).

    Costs one `scontrol` in the normal case. `sacct` is only consulted when
    scontrol does not know the job, to tell "finished earlier" from "no such
    job".
    """
    if not is_job_id(target):
        path = os.path.expanduser(target)
        parent = os.path.dirname(path) or "."
        if not os.path.isdir(parent):
            log("no such directory: %s" % parent)
            return None, 2
        if os.path.isdir(path):
            log("%s is a directory, not an output file" % path)
            return None, 2
        return [path], 0

    job_id = target
    fields = scontrol_fields(job_id)
    if fields is None:
        # No scontrol, or it does not know the job. sacct may still have it.
        state = job_state(job_id)
        if state is None:
            log(
                "cannot ask Slurm about job %s (no usable scontrol, "
                "squeue or sacct).\n"
                "  Pass the output file directly instead: "
                "slurmwatch slurm-%s.out" % (job_id, job_id)
            )
            return None, 2
        fallback = "slurm-%s.out" % job_id
        if not state and not os.path.lexists(fallback):
            log(
                "no record of job %s: not in the queue, not in the "
                "accounting log, and ./%s does not exist.\n"
                "  Check the id, or pass the output file explicitly:\n"
                "  slurmwatch path/to/%s" % (job_id, fallback, fallback)
            )
            return None, 1
        log("job %s (%s) writes to %s"
            % (job_id, state or "unknown state", fallback))
        return [fallback], 0

    state = state_from(fields)
    if not state:
        # Gone from the queue: was it real, and did it already finish?
        state = job_state(job_id) or ""

    path = output_path(fields)
    if path == os.devnull:
        log("job %s writes no output file (StdOut=/dev/null)" % job_id)
        return None, 1

    if path is None:
        # scontrol could not name the file. Accept the default name, but only
        # if the job actually exists somewhere.
        fallback = "slurm-%s.out" % job_id
        if not state and not os.path.lexists(fallback):
            log(
                "no record of job %s: not in the queue, not in the "
                "accounting log, and ./%s does not exist.\n"
                "  Check the id, or pass the output file explicitly:\n"
                "  slurmwatch path/to/%s" % (job_id, fallback, fallback)
            )
            return None, 1
        path = fallback

    log("job %s writes to %s" % (job_id, path))
    return [path], 0


def poll_job(job_id):
    """Ask Slurm once and classify the answer as (verdict, state)."""
    state = job_state(job_id)
    if state is None:
        return UNKNOWN, ""
    if is_active(state):
        return ACTIVE, state
    if state:
        return DONE, state
    return GONE, ""


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="slurmwatch",
        description="Wait for a Slurm job's output file to appear, then follow "
        "it from the first line until the job finishes.",
        epilog="examples:\n"
        "  slurmwatch 1234567\n"
        "  slurmwatch logs/run-42.log\n"
        "  slurmwatch 'slurm-*.out'\n",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("target",
                        help="Slurm job id, or a path/glob to the file")
    args = parser.parse_args(argv)

    candidates, rc = resolve(args.target)
    if candidates is None:
        return rc
    job_id = args.target if is_job_id(args.target) else None

    # Ctrl-C should end us quietly, and `slurmwatch 1 | head` should not
    # traceback.
    signal.signal(signal.SIGINT, lambda *_: sys.exit(130))
    if hasattr(signal, "SIGPIPE"):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)

    path = None
    pos = 0
    interval = POLL
    quiet_since = time.monotonic()  # when the file last grew
    job_wait = JOB_POLL             # how long quiet before asking Slurm
    next_heartbeat = time.monotonic() + HEARTBEAT
    last_state = ""

    def check_job(following):
        """Ask Slurm once and act on the answer. None means "carry on"."""
        nonlocal last_state
        verdict, state = poll_job(job_id)
        if verdict == UNKNOWN:
            return None  # cannot ask; keep going
        if verdict == ACTIVE:
            last_state = state
            return None
        if verdict == DONE:
            if not following:
                log("job %s %s without writing %s"
                    % (job_id, state, candidates[0]))
            else:
                log("job %s finished: %s" % (job_id, state))
            return 0 if following else 1
        # GONE: no record anywhere.
        if last_state:
            log("job %s is gone from the queue" % job_id)
            return 0 if following else 1
        if following:
            # Nothing knows this id, but the file is there and has been read:
            # most likely a job old enough to have been pruned from accounting.
            log("job %s is not known to Slurm; showing what is there" % job_id)
            return 0
        # Never seen running, and no file: cancelled while still queued.
        log("job %s disappeared from the queue before it started" % job_id)
        return 1

    while True:
        if path is None:
            path = locate(candidates)
            if path is None:
                if job_id and time.monotonic() - quiet_since >= job_wait:
                    quiet_since = time.monotonic()
                    job_wait = min(job_wait * BACKOFF, JOB_POLL_MAX)
                    rc = check_job(following=False)
                    if rc is not None:
                        return rc
                if time.monotonic() >= next_heartbeat:
                    next_heartbeat = time.monotonic() + HEARTBEAT
                    log("still waiting for %s" % candidates[0])
                interval = min(interval * BACKOFF, MAX_POLL)
                time.sleep(interval)
                continue

            pos = 0
            interval = POLL
            quiet_since = time.monotonic()
            job_wait = JOB_POLL
            log("following %s" % path)

        before = pos
        pos = pump(path, pos)

        if pos != before:
            # Output is arriving, so the job is alive: no need to ask Slurm,
            # and the next quiet spell is checked promptly again.
            quiet_since = time.monotonic()
            job_wait = JOB_POLL
            interval = POLL
        else:
            interval = min(interval * BACKOFF, MAX_POLL)
            if job_id and time.monotonic() - quiet_since >= job_wait:
                quiet_since = time.monotonic()
                # Back off the Slurm queries too: a job that has been silent
                # for minutes does not need checking every few seconds.
                job_wait = min(job_wait * BACKOFF, JOB_POLL_MAX)
                rc = check_job(following=True)
                if rc is not None:
                    break

        time.sleep(interval)

    # Slurm may flush a little after the job is gone; keep reading until the
    # file has been quiet for DRAIN seconds.
    last_growth = time.monotonic()
    while time.monotonic() - last_growth < DRAIN:
        time.sleep(POLL)
        before = pos
        pos = pump(path, pos)
        if pos != before:
            last_growth = time.monotonic()
    return 0


if __name__ == "__main__":
    sys.exit(main())
